<Window x:Class="IoFtp.Desktop.FileViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxFTP File Viewer" Width="940" Height="680" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INTERNAL FILE VIEWER" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PathText" Margin="0,4,12,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Encoding" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="EncodingBox" Width="170" SelectionChanged="Encoding_Changed"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBox x:Name="ContentBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="WrapBox" Content="Word wrap" Checked="Wrap_Changed" Unchecked="Wrap_Changed" VerticalAlignment="Center"/>
                <TextBlock x:Name="InfoText" Margin="18,0,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Close" HorizontalAlignment="Right" Width="76" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
