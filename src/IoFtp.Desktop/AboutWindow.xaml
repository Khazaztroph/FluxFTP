<Window x:Class="IoFtp.Desktop.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FluxFTP" Width="1040" Height="720" MinWidth="700" MinHeight="520" MaxWidth="1200" MaxHeight="900" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="24" Background="{StaticResource WindowBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Close" MinWidth="72" IsCancel="True" Click="Close_Click"/></StackPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
            <StackPanel><TextBlock><Run Text="Flux" Foreground="{StaticResource AccentBrush}"/><Run Text="FTP"/></TextBlock><TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <StackPanel Margin="8,6,18,8">
                <TextBlock Text="FluxFTP is a modern dual-pane FTP,FTPS and FXP client for Windows" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,14"/>
                <TextBlock Text="This is an early community release. Keep backups of important configuration and verify transfers before relying on it in production." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>
                <TextBlock Text="MAIN FEATURES" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="• Two independent panes that can both be Local or Remote&#x0a;• FTP, explicit FTPS (AUTH TLS) and TLS-protected data transfers&#x0a;• Direct secure FXP with CPSV/SSCN and clear PASV/PORT FXP when explicitly enabled&#x0a;• Per-site Auto, PASV or PORT FXP routing with learned-route fallback&#x0a;• Client-relay fallback when direct FXP is unavailable&#x0a;• Multiple reusable login, upload and download slots per site&#x0a;• Multi-selection, recursive folders, drag-and-drop and context-menu queueing&#x0a;• Transfer Queue and Transfer Jobs with timestamps, speed and graphical progress&#x0a;• Live Metrics for sites, slots, jobs, FXP results, speed and traffic&#x0a;• Configurable legend bar and filled aggregate transfer-progress bar&#x0a;• STAT -l with LIST fallback, selectable LIST-only mode and ProFTPD compatibility&#x0a;• PRET, CEPR, XDUPE, multiple site addresses and bouncer failover&#x0a;• ioFTPD/glFTPD command presets, synchronized SITE PRE and raw commands&#x0a;• Editable Sections, release prechecks, nuke detection and Spread Job presets&#x0a;• Simple Skiplist plus Advanced wildcard/regex Allow/Deny rules and Priority List&#x0a;• FTPRush and FlashFXP site import with bookmark support&#x0a;• External scripts, proxy settings and Windows system-tray operation&#x0a;• HTTPS/JSON and UDP automation APIs with cbftp/d-tool-compatible endpoints&#x0a;• GitHub update checks and a dark ioGUI-inspired interface"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
