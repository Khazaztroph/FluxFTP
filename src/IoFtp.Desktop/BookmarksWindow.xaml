<Window x:Class="IoFtp.Desktop.BookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmarks" Width="850" Height="560" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="BOOKMARKS" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SummaryText" Text="Saved Local and per-site paths" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Import FTPRush…" Click="Import_Click"/>
                <Button Content="Add" Click="Add_Click"/><Button Content="Edit" Click="Edit_Click"/><Button Content="Remove" Click="Remove_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="BookmarksGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="BookmarksGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="210"/>
                <DataGridTextColumn Header="SITE" Binding="{Binding SiteDisplay}" Width="190"/>
                <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
